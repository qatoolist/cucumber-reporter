{{define "scenario" -}}
<details class="scenario pg-item" id="{{.Anchor}}" data-status="{{.Status.Key}}"{{if .Open}} open{{end}}>
<summary><span class="st-{{.Status.Key}}"><span class="glyph" aria-hidden="true">{{.Status.Glyph}}</span> {{.Status.Label}}</span> <span class="kw">{{.Keyword}}:</span> {{.Name}} <span class="dur">{{.Duration}}</span>{{range .Tags}} <span class="tag">{{.}}</span>{{end}}</summary>
{{- if .Description}}
<p class="desc">{{.Description}}</p>
{{- end}}
<ol class="steps">
{{- range .Steps}}
{{template "step" .}}
{{- end}}
</ol>
</details>
{{- end}}
