{{define "step" -}}
<li class="step st-{{.Status.Key}}"><div class="line"><span class="glyph" aria-hidden="true">{{.Status.Glyph}}</span><span class="sr">{{.Status.Label}}</span> <span class="kw">{{.Keyword}}</span> {{.Name}} <span class="dur">{{.Duration}}</span>{{if .Location}} <span class="loc">{{.Location}}</span>{{end}}</div>
{{- if .Error}}
<pre class="error">{{.Error}}</pre>
{{- end}}
{{- with .DocString}}
<pre class="doc"{{if .ContentType}} data-type="{{.ContentType}}"{{end}}>{{.Value}}</pre>
{{- end}}
{{- if .Rows}}
<div class="scroll"><table class="rows"><tbody>{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}</tbody></table></div>
{{- end}}
{{- range .Attachments}}
<details class="att"><summary>{{.Name}} <span class="meta">{{.MimeType}}{{if .Size}} · {{.Size}}{{end}}</span></summary>
{{- if or (eq .Kind "text") (eq .Kind "json")}}
{{- if .Note}}<p class="note">{{.Note}}</p>{{end}}
<button type="button" class="copy js" data-copy="{{.ID}}" hidden>Copy</button>
<pre id="{{.ID}}">{{.Text}}</pre>
{{- else if eq .Kind "sidecar"}}
<p><a href="{{.Href}}">Open {{.Href}}</a> (too large to show inline; saved as text beside this report)</p>
{{- else if eq .Kind "binary"}}
<p class="note">{{.MimeType}} · {{.Size}} · content not shown</p>
{{- else}}
<p class="note">{{.Note}}</p>
{{- end}}
</details>
{{- end}}
</li>
{{- end}}
