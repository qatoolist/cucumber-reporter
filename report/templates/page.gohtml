<!DOCTYPE html>
<html lang="en"{{if ne .Defaults.Theme "auto"}} data-theme="{{.Defaults.Theme}}"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
{{.Head}}
<title>{{.Name}}</title>
</head>
<body>
<noscript><div class="nj">
<p>{{.Title}}</p>
<h1><bdi>{{.Name}}</bdi></h1>
<p class="nj-v{{with toneClass .Verdict.Tone}} {{.}}{{end}}">{{.Verdict.Label}}</p>
<p>This is the static version of the report. Enable JavaScript for the dashboard, search, filters and charts.</p>
{{- if .Facts}}
<h2>Run facts</h2><table><tbody>{{range .Facts}}<tr><th>{{.Label}}</th><td><bdi>{{.Value}}</bdi></td></tr>{{end}}</tbody></table>
{{- end}}
<h2>Summary</h2><table><thead><tr><th>Status</th><th>Scenarios</th></tr></thead><tbody>{{range .Summary}}<tr><td class="st s-{{.Status}}">{{label .Status}}</td><td>{{.N}}</td></tr>{{end}}<tr><th>Total</th><th>{{.Total}}</th></tr></tbody></table>
{{- range .Sections}}
<h2><bdi>{{.Title}}</bdi></h2>{{if or .Summary .Rows}}<table><tbody>{{range .Summary}}<tr><th>{{.Label}}</th><td><bdi>{{.Value}}</bdi></td></tr>{{end}}{{range .Rows}}<tr><th>{{.Label}}</th><td><bdi>{{.Value}}</bdi></td></tr>{{end}}</tbody></table>{{end}}
{{- with .Note}}
<p>{{.}}</p>
{{- end}}
{{- end}}
<h2>Features</h2>
{{- range .Features}}
<h2><bdi>{{.Name}}</bdi></h2><p><code>{{.URI}}</code> {{join .Tags}}</p>
{{- range .Elements}}
<details{{if open .Status}} open{{end}}><summary><span class="st s-{{.Status}}">{{label .Status}}</span> {{.Keyword}}: <bdi>{{.Name}}</bdi> · {{dur .Duration}} {{join .Tags}}</summary>
{{- range .Notes}}
<p>{{.}}</p>
{{- end}}
<ol>
{{- range .Steps}}
<li><span class="st s-{{if .Known}}known{{else}}{{.Status}}{{end}}">{{if .Known}}{{label "known"}}{{else}}{{label .Status}}{{end}}</span> <b>{{trim .Keyword}}</b> <bdi>{{.Name}}</bdi> · {{with .Duration}}{{dur .}}{{else}}—{{end}}
{{- if .Rows}}<table><tbody>{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}</tbody></table>{{end}}
{{- with .Doc}}<pre>{{.Value}}</pre>{{end}}
{{- if and .Error (ne .Status "passed")}}<pre>{{.Error}}</pre>{{end}}
{{- range .Att}}<p>Attachment: {{.Name}} ({{.Mime}}, {{if .Note}}{{.Note}}{{else}}{{.Size}} bytes{{end}}){{with .Href}} <a href="{{.}}">Open the file</a>{{end}}</p>{{end}}</li>
{{- end}}
</ol></details>
{{- end}}
{{- end}}
</div></noscript>
<script type="application/json" id="report-data">{{.Data}}</script>
{{.Script}}
</body>
</html>
