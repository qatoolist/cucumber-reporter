{{define "chart" -}}
<figure class="chart" id="chart-{{.ID}}" data-chart="{{.ID}}"{{if .Hidden}} hidden{{end}}>
<figcaption>{{.Title}}</figcaption>
{{- if eq .Kind "donut"}}
<div class="donut-wrap">
<svg class="donut" viewBox="0 0 42 42" role="img" aria-labelledby="chart-{{.ID}}-t"><title id="chart-{{.ID}}-t">{{.Summary}}</title><circle class="ring" cx="21" cy="21" r="15.9155" fill="none" stroke-width="6"></circle>{{range .Donut}}<circle class="{{.Class}}" cx="21" cy="21" r="15.9155" fill="none" stroke-width="6" stroke-dasharray="{{.Dash}}" stroke-dashoffset="{{.Offset}}"></circle>{{end}}<text x="21" y="23.5" text-anchor="middle" class="donut-total">{{.Total}}</text></svg>
{{template "legend" .}}
</div>
{{- else if eq .Kind "stack"}}
<svg class="stack" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-labelledby="chart-{{.ID}}-t"><title id="chart-{{.ID}}-t">{{.Summary}}</title>{{range .Stack}}<rect class="{{.Class}}" x="{{.X}}" y="0" width="{{.Width}}" height="8"></rect>{{end}}</svg>
{{template "legend" .}}
{{- end}}
{{- if .Bars}}
<ol class="bars">
{{- range .Bars}}
<li><a href="{{.Href}}">{{.Label}}</a><svg class="hbar" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">{{range .Segments}}<rect class="{{.Class}}" x="{{.X}}" y="0" width="{{.Width}}" height="6"></rect>{{end}}</svg><span class="val">{{.Value}}</span>{{if .Sub}}<span class="meta">{{.Sub}}</span>{{end}}</li>
{{- end}}
</ol>
{{- end}}
{{- if .Note}}
<p class="note">{{.Note}}</p>
{{- end}}
</figure>
{{- end}}

{{define "legend" -}}
<table class="legend"><tbody>{{range .Legend}}<tr><th scope="row"><span class="key {{.Class}}" aria-hidden="true">{{if .Glyph}}{{.Glyph}}{{else}}■{{end}}</span> {{.Label}}</th><td>{{.N}}</td><td>{{.Percent}}</td></tr>{{end}}</tbody></table>
{{- end}}

{{define "section" -}}
<section class="card tone-{{.Tone}}" id="sec-{{.ID}}" data-section="{{.ID}}" aria-labelledby="sec-{{.ID}}-h"{{if .Hidden}} hidden{{end}}>
<h3 id="sec-{{.ID}}-h">{{.Title}}</h3>
{{- if .Summary}}
<dl class="facts">{{range .Summary}}<div><dt>{{.Label}}</dt><dd>{{.Value}}</dd></div>{{end}}</dl>
{{- end}}
{{- if .Rows}}
<div class="scroll"><table class="rows"><tbody>{{range .Rows}}<tr><th scope="row">{{.Label}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table></div>
{{- end}}
{{- if .Note}}
<p class="note">{{.Note}}</p>
{{- end}}
</section>
{{- end}}
