{{define "features" -}}
<section id="features" aria-labelledby="features-h">
<h2 id="features-h">Features</h2>
<div class="filters js" hidden>
<label>Search <input type="search" id="search" autocomplete="off" aria-keyshortcuts="/"></label>
<label>Status <select id="status-filter" aria-keyshortcuts="f"><option value="">All</option>{{range .Statuses}}<option value="{{.Key}}">{{.Label}}</option>{{end}}</select></label>
<span id="match-count" role="status"></span>
</div>
<div class="scroll">
<table class="ftable">
<thead><tr><th scope="col" data-sort="text">Feature</th><th scope="col" data-sort="text">Status</th><th scope="col" data-sort="num">Scenarios</th><th scope="col" data-sort="num">Passed</th><th scope="col" data-sort="num">Failed</th><th scope="col" data-sort="num">Other</th><th scope="col" data-sort="num">Steps</th><th scope="col" data-sort="num">Duration</th></tr></thead>
<tbody data-pager>
{{- range .Features}}
<tr class="pg-item" data-status="{{.Status.Key}}" data-target="{{.Anchor}}" data-search="{{.Search}}"><td><a href="#{{.Anchor}}">{{.Name}}</a></td><td class="st-{{.Status.Key}}"><span class="glyph" aria-hidden="true">{{.Status.Glyph}}</span> {{.Status.Label}}</td><td data-v="{{len .Scenarios}}">{{len .Scenarios}}</td><td data-v="{{.Passed}}">{{.Passed}}</td><td data-v="{{.Failed}}">{{.Failed}}</td><td data-v="{{.Other}}">{{.Other}}</td><td data-v="{{.Steps}}">{{.Steps}}</td><td data-v="{{.DurationNS}}">{{.Duration}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- range .Features}}
<section class="feature" id="{{.Anchor}}" aria-labelledby="{{.Anchor}}-h">
<h3 id="{{.Anchor}}-h"><span class="st-{{.Status.Key}}"><span class="glyph" aria-hidden="true">{{.Status.Glyph}}</span> {{.Status.Label}}</span> {{.Keyword}}: {{.Name}}</h3>
<p class="meta"><span class="uri">{{.URI}}</span> · {{.Duration}}{{range .Tags}} <span class="tag">{{.}}</span>{{end}}</p>
{{- if .Description}}
<p class="desc">{{.Description}}</p>
{{- end}}
<div class="scenarios" data-pager>
{{- range .Scenarios}}
{{template "scenario" .}}
{{- end}}
</div>
</section>
{{- end}}
</section>
{{- end}}
